diff --git a/components/drivers/pic/pic-gicv3.c b/components/drivers/pic/pic-gicv3.c
index 7a11f35de..03c5cb50e 100644
--- a/components/drivers/pic/pic-gicv3.c
+++ b/components/drivers/pic/pic-gicv3.c
@@ -992,6 +992,11 @@ static void gicv3_init(void)
     _gic.parent.ops = &gicv3_ops;
 
     rt_pic_linear_irq(&_gic.parent, _gic.irq_nr - GIC_SGI_NR);
+    /* Expose the virtual timer PPI (INTID 27) so guests can use CNTV.
+     * Configure both the irq-hash slot used by rt_hw_interrupt_install()
+     * and the slot the GIC handler derives from the IAR. */
+    rt_pic_config_irq(&_gic.parent, 27 - _gic.parent.irq_start, 27);
+    rt_pic_config_irq(&_gic.parent, 27 - GIC_SGI_NR, 27);
     gic_common_sgi_config(_gic.dist_base, &_gic.parent, 0);
 
     rt_pic_add_traps(gicv3_handler, &_gic);
