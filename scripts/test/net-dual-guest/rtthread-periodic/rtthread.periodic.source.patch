+++ b/components/drivers/serial/dev_serial.c
@@ -1253,6 +1253,7 @@ static rt_err_t rt_serial_control(struct rt_device *dev,
                     p_winsize->ws_col = 80;
                     p_winsize->ws_row = 24;
                 }
+#ifdef RT_USING_FINSH
                 else
                 {
                     #include <shell.h>
@@ -1320,6 +1321,14 @@ static rt_err_t rt_serial_control(struct rt_device *dev,
                     p_winsize->ws_row = atoi(row_s);
                 #undef _TIO_BUFLEN
                 }
+#else
+                else
+                {
+                    /* FINSH is disabled; report the default window size. */
+                    p_winsize->ws_col = 80;
+                    p_winsize->ws_row = 24;
+                }
+#endif
 
                 p_winsize->ws_xpixel = 0;/* unused */
                 p_winsize->ws_ypixel = 0;/* unused */
